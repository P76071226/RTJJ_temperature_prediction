  "components": [
    {
      "name": "market_collector.py",
      "description": "Fetches 10 binary markets from Polymarket API for target date",
      "input": "Date",
      "output": "data/market_raw.json",
      "schedule": "Every run"
    },
    {
      "name": "osint_researcher.py",
      "description": "Queries Open-Meteo forecast + JMA METAR observations",
      "input": "Date",
      "output": "data/osint_features.json",
      "schedule": "Every run"
    },
    {
      "name": "model_builder.py",
      "description": "XGBoost + Isotonic calibration predicts interval probabilities",
      "input": "Features",
      "output": "data/model_probs.json",
      "schedule": "Every run"
    },
    {
      "name": "validator.py",
      "description": "Compares model vs market, detects edges > 8pp",
      "input": "Probs",
      "output": "data/validation_log.json",
      "schedule": "Every run"
    },
    {
      "name": "report_generator.py",
      "description": "Generates HTML dashboard with Chart.js visualizations",
      "input": "All data",
      "output": "reports/report_*.html",
      "schedule": "Every run"
    },
    {
      "name": "orchestrator.py",
      "description": "Main pipeline coordinator, archives runs, sends Telegram alerts",
      "input": "None",
      "output": "Archive + Reports",
      "schedule": "Every 6hr via cron"
    }
  ],
  "cron_jobs": [
    {
      "name": "rjtt_temp_prediction",
      "schedule": "Every 6 hours",
      "command": "proot-distro login ubuntu -- bash -c 'source ~/ml_env/bin/activate && cd /root/hermes_research/rjtt_project && python3 orchestrator.py'"
